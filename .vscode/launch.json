{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "House MCP",
      "type": "debugpy",
      "request": "launch",
      "module": "tahoe_operator.mcp_server",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Operator API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["tahoe_operator.api:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "compounds": [
    {
      "name": "Tahoe MVP (API + House MCP)",
      "configurations": ["House MCP", "Operator API"],
      "stopAll": true
    }
  ]
}
