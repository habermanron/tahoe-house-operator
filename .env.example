# Copy to .env. Use the OpenAI-compatible model gateway you already have access to.
MODEL_GATEWAY_BASE_URL=https://your-gateway.example/v1
MODEL_GATEWAY_API_KEY=replace-me
MODEL_NAME=your-chat-model
EMBEDDING_MODEL=your-embedding-model

# Local services and data
API_HOST=127.0.0.1
API_PORT=8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_URL=http://127.0.0.1:8001/mcp
DATABASE_PATH=data/tahoe.sqlite
CORPUS_PATH=data/corpus
VECTOR_STORE_PATH=data/vector_store
ALLOW_KEYWORD_RAG_FALLBACK=true
